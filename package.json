{
  "name": "bridgetogrowth-learning",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --hot src/server/index.ts",
    "build": "bun scripts/build.ts",
    "start": "NODE_ENV=production bun src/server/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "migrate": "bun scripts/migrate.ts",
    "desktop:dev": "cd desktop && bunx electrobun dev --watch",
    "desktop:build": "cd desktop && bunx electrobun build --env=stable",
    "package:linux": "bun scripts/fetch-pyodide.ts && bun run desktop:build && bun scripts/package-linux.ts",
    "smoke": "bun scripts/smoke.ts",
    "make": "bun scripts/make-app.ts"
  },
  "dependencies": {
    "bun-plugin-tailwind": "0.1.2",
    "d3-force": "3.0.0",
    "electrobun": "2.0.5",
    "fflate": "0.8.3",
    "katex": "0.19.1",
    "pyodide": "314.0.7",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "10.1.0",
    "rehype-katex": "7.0.1",
    "remark-math": "6.0.0",
    "tailwindcss": "4.3.3",
    "unpdf": "2.1.0",
    "wouter": "3.13.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/bun": "1.4.4",
    "@types/d3-force": "3.0.10",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "typescript": "7.0.2"
  }
}
