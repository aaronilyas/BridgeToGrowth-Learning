# Copy to deployment/.env (ignored by git). Fill every blank before starting.
# Generate URL-safe secrets with: openssl rand -hex 32
# POSTGRES_PASSWORD must be URL-safe because Compose embeds it in DATABASE_URL.
POSTGRES_PASSWORD=
MESSAGING_TOKEN=
PROJECT_ID=
PROJECT_SECRET=
GEMINI_API_KEY=
GEMINI_MODEL=
# Trusted identity provider; see backend/README.md for the GET/JSON contract.
AUTH_INTROSPECTION_URL=

API_PORT=8000
# This image must be built on the same Docker daemon used by the coordinator.
USER_CONTAINER_IMAGE=btg-renderer:local
# Docker Desktop may require /var/run/docker.sock inside its VM, even when the
# host CLI uses a socket in your home directory. This is a daemon-side bind path.
DOCKER_SOCKET_PATH=/var/run/docker.sock
