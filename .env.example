# Single backend deployment configuration. Copy: cp .env.example .env
# Protect: chmod 600 .env. Never commit .env or .local/backend/.
# Requires Docker Engine/Desktop + Compose v2 and host Python 3.10+.
# Literal KEY=value only (optional single/double quotes, comments supported).
# No shell evaluation, interpolation ($), backticks, escapes or multiline values.
# Empty required values fail before any containers start. No secrets auto-rotate.

# REQUIRED: URL-safe DB password, >=20 chars. Generate: openssl rand -hex 32
# Existing PostgreSQL volumes retain their original password; changing this value
# requires deliberate SQL password rotation (see compose.md), not volume deletion.
POSTGRES_PASSWORD=

# REQUIRED: generate EACH INDEPENDENTLY: openssl rand -hex 32
# Distinct from one another and the DB password, >=32 chars; template/low-diversity values are rejected.
AUTH_CODE_SECRET=
RECEIPT_SECRET=
MESSAGING_TOKEN=

# REQUIRED: Gemini API key and Photon/Spectrum Cloud project credentials.
# Obtain credentials from the respective provider dashboards; never EXPO_PUBLIC_*.
GEMINI_API_KEY=
PROJECT_ID=
PROJECT_SECRET=
# Optional model ID; ensure this model is available to your Gemini project.
GEMINI_MODEL=gemini-2.5-flash

# Optional Docker/local defaults. Host API stays on loopback only.
API_PORT=8000
USER_CONTAINER_IMAGE=btg-renderer:local
RENDERER_EGRESS_IMAGE=btg-egress:local
# Daemon-side socket path. Docker Desktop's VM commonly uses this path.
DOCKER_SOCKET_PATH=/var/run/docker.sock

# Optional cost limits. Count new requests (including failed/cancelled work),
# excluding matching idempotent retries. Window persists through restarts.
LESSON_REQUEST_LIMIT=10
LESSON_REQUEST_WINDOW_SECONDS=86400
LESSON_ACCOUNT_JOB_LIMIT=2
LESSON_GLOBAL_JOB_LIMIT=8

# Reuse the existing externally managed host connector by default.
# false or --local-only uses LOCAL_API_PORT, never the public port 8000.
CLOUDFLARE_ENABLED=true
CLOUDFLARE_TUNNEL_MODE=external
CLOUDFLARE_HOSTNAME=bridgetogrowth-learning.com
# External mode: existing UUID + read-only inspection token; no provisioning
# or connector token needed. See cloudflare.md for exact read scopes/operator actions.
CLOUDFLARE_TUNNEL_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_ZONE_ID=
# Private staging port: must differ from 8000 and have no other forwarding route.
LOCAL_API_PORT=18000
# Optional managed mode for a different deployment only. Requires unused remote
# name/hostname, Edit permissions, and saved ownership state. Do not use for the
# existing host connector. Never auto-adopts existing DNS/tunnels.
CLOUDFLARE_TUNNEL_NAME=btg-learning-api

# Compose derives private DATABASE_URL, MESSAGING_URL and RECEIPT_URL internally.
# No second deployment/.env. Existing route/policy must pass read-only inspection.
# MOBILE BUILD ONLY (frontend/.env or your mobile build secret/config store):
# EXPO_PUBLIC_API_BASE_URL=https://<your-CLOUDFLARE_HOSTNAME>
# This public origin contains NO credentials; backend startup does not edit the app.
