NODE_ENV=development
# Public origin. Local: http://localhost:3000. Production must be https://<your-host>.
APP_ORIGIN=http://localhost:3000
# Local Postgres. Production uses the managed database URI and includes sslmode=require.
DATABASE_URL=postgres://btg:change-me@127.0.0.1:5432/btg
OPENROUTER_API_KEY=placeholder
OPENALEX_MAILTO=ops@example.com

# Stripe (test mode locally: sk_test_..., live mode in production: sk_live_... or a restricted rk_live_... key).
# STRIPE_PRICE_ID is the recurring monthly price for Pro; scripts/stripe-setup.ts creates it from PRO_PRICE_USD.
# Locally, `stripe listen --forward-to localhost:3000/api/stripe/webhook` prints the whsec_ value to use.
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
STRIPE_PRICE_ID=price_replace_me

# Cloudflare Turnstile on sign-up and sign-in. These are Cloudflare's always-pass test keys, fine for local use.
# Production refuses to start with them: create a widget for your hostname and use its keys.
TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET=1x0000000000000000000000000000000AA

# Plans. Usage caps are the monthly AI spend per account in USD (OpenRouter cost), reset on the 1st (UTC).
FREE_CAP_USD=0.20
PRO_CAP_USD=5.99
# What the app shows for Pro. Stripe charges the STRIPE_PRICE_ID amount, so keep them the same.
PRO_PRICE_USD=9.99
# Lessons created on the Free plan are deleted this many days after creation.
FREE_LESSON_TTL_DAYS=7

# Schema defaults, not assigned here: PORT 3000, OPENROUTER_BASE_URL https://openrouter.ai/api/v1, OPENROUTER_MODEL openrouter/free, OPENROUTER_REASONING_LEVEL high.

# Optional, and only as a pair. They let the sign-in page email a one-hour password reset link via Resend.
# RESEND_API_KEY=re_replace_me
# MAIL_FROM=BridgeToGrowth <learn@example.com>
