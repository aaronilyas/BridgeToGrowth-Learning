# Combined backend, messaging and frontend configuration reference.
# Copy to .env and fill the blank values. Never commit the populated file.
# Backend/Node processes need these values explicitly loaded into their environment.
# For Compose, use: docker compose --env-file .env ...
# Compose supplies its own internal DATABASE_URL, MESSAGING_URL and receipt settings.
# Expo loads frontend/.env: copy ONLY EXPO_PUBLIC_API_BASE_URL there.

# Backend: PostgreSQL URL using the psycopg driver. URL-encode credentials.
DATABASE_URL=postgresql+psycopg://btg:replace-with-url-safe-password@127.0.0.1:5432/btg

# Generate each of these three independently with: openssl rand -hex 32
# They must be distinct and contain at least 32 characters.
# Share MESSAGING_TOKEN and RECEIPT_SECRET with the messaging service.
AUTH_CODE_SECRET=
RECEIPT_SECRET=
MESSAGING_TOKEN=

# Gemini credentials and the model ID available to your project.
GEMINI_API_KEY=
GEMINI_MODEL=

# Trusted Node messaging endpoint; the path must be exactly /video.
MESSAGING_URL=http://127.0.0.1:3001/video
# Build both images on the Docker daemon used by the backend.
RENDERER_EGRESS_IMAGE=btg-egress:local
# Optional backend override (shown with its default).
USER_CONTAINER_IMAGE=btg-renderer:local

# Node.js/TypeScript messaging service: Photon dashboard credentials.
PROJECT_ID=
PROJECT_SECRET=
# Private backend callback and writable directory for receipt metadata only.
RECEIPT_URL=http://127.0.0.1:8000/internal/receipts
RECEIPT_SPOOL_DIR=/var/lib/btg/receipts
# Optional messaging settings (shown with their defaults).
HOST=127.0.0.1
PORT=3001
MAX_VIDEO_BYTES=52428800

# Docker Compose: URL-safe database password; Compose constructs DATABASE_URL.
POSTGRES_PASSWORD=
# Optional Compose settings (shown with their defaults).
API_PORT=8000
# Daemon-side socket bind path; Docker Desktop may use its VM's socket path.
DOCKER_SOCKET_PATH=/var/run/docker.sock

# Frontend: public HTTPS API origin, without a trailing slash or path.
# Embedded in the app; put no secrets in EXPO_PUBLIC_* variables.
# Use an address reachable from the device. Restart Expo after changing it.
EXPO_PUBLIC_API_BASE_URL=https://api.example.com
