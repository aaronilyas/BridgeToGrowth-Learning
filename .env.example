# Optional. The desktop app needs no configuration: AI keys are entered in Settings and stored in the OS keychain.
# NODE_ENV=development
# Override the data directory (default: XDG data dir, ~/Library/Application Support, or %APPDATA%).
# BTG_DATA_DIR=/path/to/data
# Point OpenRouter calls at a different OpenAI-compatible base URL.
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
